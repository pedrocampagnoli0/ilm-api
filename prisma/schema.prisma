// ─────────────────────────────────────────────────────────
// ILM API — Prisma Schema (Phase 1-2: escola + municipio + dependencies)
//
// This is a PARTIAL schema covering tables needed for the
// escola module. Run `prisma db pull` to replace with the
// full auto-generated schema from Supabase.
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum tamanho_camiseta {
  P
  M
  G
  GG
}

enum resultado_login {
  sucesso
  falha
}

enum reuniao_tipo {
  professor_1_1 @map("1:1-professor")
  gestao
  generica
}

enum reuniao_recorrencia_regra {
  semanal
  quinzenal
  mensal
  mensal_semana @map("mensal-semana")
}

// ─── Tables ──────────────────────────────────────────────

model perfil {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  usuarios usuario[]
}

model municipio {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  uf_sigla            String    @db.VarChar(2)
  ativo               Boolean   @default(true)
  logo_municipio_url  String?
  timezone            String    @default("America/Araguaina")
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  uf                  uf     @relation(fields: [uf_sigla], references: [sigla])
  escolas             escola[]
  usuarios            usuario[]
  alunos              aluno[]
  avaliacoes          avaliacao[]
  livros_ativos       municipio_livros_ativos[]
  import_batches       import_batch[]
  import_aluno_batches import_aluno_batch[]
  ranking_professores  ranking_professor_diario[] @relation("ranking_prof_municipio")
  ranking_escolas      ranking_escola_diario[]    @relation("ranking_escola_municipio")
  reunioes             reuniao[]
  observacoes          observacao_assessora[]
  tentativas_contato   tentativa_contato[]
  feriados             feriado[]
  contatos_principais  contato_principal[]
  assessora_municipios assessora_municipio[]
}

model usuario {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome              String
  email             String             @unique
  auth_user_id      String?            @unique @db.Uuid
  perfil_id         String             @db.Uuid
  municipio_id      String?            @db.Uuid
  ativo             Boolean            @default(true)
  tamanho_camiseta  tamanho_camiseta?
  telefone          String?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  perfil    perfil     @relation(fields: [perfil_id], references: [id])
  municipio municipio? @relation(fields: [municipio_id], references: [id])

  // Reverse relations
  escolas_as_coord_inf  escola[] @relation("escola_coord_inf")
  escolas_as_coord_fund escola[] @relation("escola_coord_fund")
  escolas_as_diretor    escola[] @relation("escola_diretor")
  turmas_as_professora  turma[]  @relation("turma_professora")
  turmas_as_auxiliar    turma[]  @relation("turma_auxiliar")
  rankings              ranking_professor_diario[]
  import_batches        import_batch[]
  import_aluno_batches  import_aluno_batch[]
  reunioes_pessoa       reuniao_pessoa[]
  reunioes_criadas      reuniao[]              @relation("reuniao_criado_por")
  observacoes_alvo      observacao_assessora[] @relation("observacao_pessoa")
  observacoes_criadas   observacao_assessora[] @relation("observacao_criado_por")
  tentativas_alvo       tentativa_contato[]    @relation("tentativa_pessoa")
  tentativas_criadas    tentativa_contato[]    @relation("tentativa_criado_por")
  contatos_principais   contato_principal[]
  assessora_municipios  assessora_municipio[]  @relation("assessora")
  assessora_municipios_created assessora_municipio[] @relation("assessora_creator")
  impersonate_perm       usuario_impersonate_perm?  @relation("impersonate_target")
  impersonate_perms_granted usuario_impersonate_perm[] @relation("impersonate_grantor")
  nutror_conclusoes         nutror_modulo_conclusao[]
  nutror_enrollments        nutror_enrollment[]
}

model eduzz_webhook_event {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_externo_id String?   @unique
  event_type        String
  payload           Json      @db.JsonB
  signature         String?
  signature_valid   Boolean?
  received_at       DateTime  @default(now()) @db.Timestamptz(6)
  processed_at      DateTime? @db.Timestamptz(6)
  processing_error  String?

  conclusoes        nutror_modulo_conclusao[]

  @@index([received_at(sort: Desc)], map: "idx_eduzz_webhook_event_received_at")
  @@map("eduzz_webhook_event")
}

model nutror_curso {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_hash    String   @unique
  titulo         String
  modulos_totais Int?
  ativo          Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  conclusoes     nutror_modulo_conclusao[]
  enrollments    nutror_enrollment[]

  @@map("nutror_curso")
}

model nutror_enrollment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learner_email         String
  nutror_student_id     String
  nutror_enrollment_id  String    @unique
  course_hash           String
  course_titulo         String?
  curso_id              String?   @db.Uuid
  usuario_id            String?   @db.Uuid
  progress              Decimal   @db.Decimal(5, 2)
  status                String
  all_modules_released  Boolean?
  matriculado_em        DateTime  @db.Timestamptz(6)
  expira_em             DateTime? @db.Timestamptz(6)
  termos_aceitos_em     DateTime? @db.Timestamptz(6)
  last_synced_at        DateTime  @default(now()) @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  curso   nutror_curso? @relation(fields: [curso_id], references: [id], onDelete: SetNull)
  usuario usuario?      @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([usuario_id], map: "idx_nutror_enrollment_usuario")
  @@index([curso_id], map: "idx_nutror_enrollment_curso")
  @@index([learner_email], map: "idx_nutror_enrollment_email")
  @@index([course_hash], map: "idx_nutror_enrollment_course_hash")
  @@map("nutror_enrollment")
}

model nutror_modulo_conclusao {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String?  @db.Uuid
  learner_email String
  learner_nome  String?
  curso_id      String   @db.Uuid
  module_id     String
  module_titulo String?
  lesson_id     String?
  lesson_titulo String?
  concluido_em  DateTime @db.Timestamptz(6)
  evento_id     String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  usuario usuario?             @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  curso   nutror_curso         @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  evento  eduzz_webhook_event? @relation(fields: [evento_id], references: [id], onDelete: SetNull)

  @@unique([learner_email, curso_id, module_id], name: "uq_nutror_conclusao", map: "uq_nutror_conclusao")
  @@index([usuario_id, concluido_em(sort: Desc)], map: "idx_nutror_conclusao_usuario_concluido")
  @@index([learner_email], map: "idx_nutror_conclusao_learner_email")
  @@index([curso_id], map: "idx_nutror_conclusao_curso")
  @@map("nutror_modulo_conclusao")
}

model escola {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  municipio_id  String   @db.Uuid
  coord_inf_id  String?  @db.Uuid
  coord_fund_id String?  @db.Uuid
  diretor_id    String?  @db.Uuid
  ativo         Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  municipio  municipio @relation(fields: [municipio_id], references: [id])
  coord_inf  usuario?  @relation("escola_coord_inf", fields: [coord_inf_id], references: [id])
  coord_fund usuario?  @relation("escola_coord_fund", fields: [coord_fund_id], references: [id])
  diretor    usuario?  @relation("escola_diretor", fields: [diretor_id], references: [id])

  turmas              turma[]
  alunos              aluno[]
  ranking_professores ranking_professor_diario[] @relation("ranking_prof_escola")
  ranking_escolas     ranking_escola_diario[]    @relation("ranking_escola_escola")

  @@index([municipio_id])
}

model ciclo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  turmas              turma[]
  resultados          resultado_avaliacao[]
  livros              livro[]
  ranking_professores ranking_professor_diario[] @relation("ranking_prof_ciclo")
  ranking_escolas     ranking_escola_diario[]    @relation("ranking_escola_ciclo")
}

model turma {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  escola_id      String   @db.Uuid
  ciclo_id       String   @db.Uuid
  professora_id  String   @db.Uuid
  auxiliar_id    String?  @db.Uuid
  ativo          Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  escola     escola  @relation(fields: [escola_id], references: [id])
  ciclo      ciclo   @relation(fields: [ciclo_id], references: [id])
  professora usuario @relation("turma_professora", fields: [professora_id], references: [id])
  auxiliar   usuario? @relation("turma_auxiliar", fields: [auxiliar_id], references: [id])

  alunos             aluno[]
  resultados         resultado_avaliacao[]
  import_batch_items import_aluno_batch_item[]

  @@index([escola_id, ciclo_id, ativo])
}

model aluno {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome            String
  turma_id        String    @db.Uuid
  escola_id       String    @db.Uuid
  municipio_id    String    @db.Uuid
  is_inclusao     Boolean   @default(false)
  is_transferido  Boolean   @default(false)
  transferido_em  DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  turma      turma     @relation(fields: [turma_id], references: [id])
  escola     escola    @relation(fields: [escola_id], references: [id])
  municipio  municipio @relation(fields: [municipio_id], references: [id])
  resultados resultado_avaliacao[]
  import_batch_items import_aluno_batch_item[]

  @@index([turma_id])
  @@index([is_transferido], map: "idx_aluno_is_transferido")
}

model tipo_avaliacao {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  avaliacoes          avaliacao[]
  ranking_professores ranking_professor_diario[] @relation("ranking_prof_tipo")
  ranking_escolas     ranking_escola_diario[]    @relation("ranking_escola_tipo")
}

model avaliacao {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id  String    @db.Uuid
  tipo_id       String    @db.Uuid
  data_inicio   DateTime? @db.Date
  data_termino  DateTime? @db.Date
  ativo         Boolean   @default(true)
  closed_at     DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  municipio       municipio         @relation(fields: [municipio_id], references: [id])
  tipo_avaliacao  tipo_avaliacao    @relation(fields: [tipo_id], references: [id])
  resultados      resultado_avaliacao[]

  @@index([municipio_id])
}

model resultado_avaliacao {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aluno_id     String    @db.Uuid
  avaliacao_id String    @db.Uuid
  turma_id     String    @db.Uuid
  ciclo_id     String    @db.Uuid
  ausente      Boolean   @default(false)
  respondido_em DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  // EI2 (Educação Infantil 2) fields
  ei2_escreve_nome          Boolean? @db.Boolean
  ei2_sons_letras           Int?     @db.SmallInt
  ei2_nomes_letras          Int?     @db.SmallInt
  ei2_consciencia_fonemica  Int?     @db.SmallInt
  ei2_consciencia_fonologica Int?    @db.SmallInt
  ei2_nivel_leitura         Int?     @db.SmallInt
  ei2_nivel_escrita         Int?     @db.SmallInt

  // F1 (Fundamental 1) fields
  f1_escreve_nome           Boolean? @db.Boolean
  f1_consciencia_fonemica   Int?     @db.SmallInt
  f1_consciencia_fonologica Int?     @db.SmallInt
  f1_nivel_leitura          Int?     @db.SmallInt
  f1_nivel_escrita          Int?     @db.SmallInt
  f1_compreensao_frases     Int?     @db.SmallInt

  // F2 (Fundamental 2) fields
  f2_nivel_leitura          Int?     @db.SmallInt
  f2_nivel_escrita          Int?     @db.SmallInt
  f2_compreensao_frases     Int?     @db.SmallInt
  f2_compreensao_texto      Int?     @db.SmallInt
  f2_consciencia_fonemica   Int?     @db.SmallInt

  aluno     aluno     @relation(fields: [aluno_id], references: [id])
  avaliacao avaliacao @relation(fields: [avaliacao_id], references: [id])
  turma     turma     @relation(fields: [turma_id], references: [id])
  ciclo     ciclo     @relation(fields: [ciclo_id], references: [id])

  @@unique([avaliacao_id, aluno_id], map: "uq_resultado_avaliacao_aluno")
  @@index([avaliacao_id, turma_id], map: "idx_resultado_avaliacao_avaliacao_turma")
  @@index([avaliacao_id], map: "idx_resultado_avaliacao_avaliacao_id")
  @@index([turma_id], map: "idx_resultado_avaliacao_turma_id")
  @@index([aluno_id], map: "idx_resultado_avaliacao_aluno_id")
}

model uf {
  sigla String @id @db.VarChar(2)
  nome  String

  municipios municipio[]
  feriados   feriado[]

  @@map("uf")
}

model livro {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo        String
  ciclo_id      String    @db.Uuid
  flipbook_url  String?
  ativo         Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  ciclo             ciclo    @relation(fields: [ciclo_id], references: [id])
  municipios_ativos municipio_livros_ativos[]
}

model municipio_livros_ativos {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id  String   @db.Uuid
  livro_id      String   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  municipio municipio @relation(fields: [municipio_id], references: [id])
  livro     livro     @relation(fields: [livro_id], references: [id])

  @@unique([municipio_id, livro_id])
  @@index([municipio_id])
}

// ─── Log / Ranking / Import ─────────────────────────────

model log_tentativa_login {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?
  resultado     resultado_login?
  erro_detalhe  String?
  ip            String?
  user_agent    String?
  criado_em     DateTime         @default(now()) @db.Timestamptz(6)
}

model ranking_professor_diario {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_referencia     DateTime  @db.Date
  professor_id        String    @db.Uuid
  escola_id           String    @db.Uuid
  municipio_id        String    @db.Uuid
  ciclo_id            String    @db.Uuid
  ciclo_nome          String
  tipo_avaliacao_id   String    @db.Uuid
  total_alunos        Int
  pontuacao_total_sum Float
  pontuacao_total_avg Float
  posicao_escola      Int?
  posicao_municipio   Int?
  posicao_geral       Int?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  professor      usuario        @relation(fields: [professor_id], references: [id])
  escola         escola         @relation("ranking_prof_escola", fields: [escola_id], references: [id])
  municipio      municipio      @relation("ranking_prof_municipio", fields: [municipio_id], references: [id])
  ciclo          ciclo          @relation("ranking_prof_ciclo", fields: [ciclo_id], references: [id])
  tipo_avaliacao tipo_avaliacao @relation("ranking_prof_tipo", fields: [tipo_avaliacao_id], references: [id])
}

model ranking_escola_diario {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_referencia     DateTime  @db.Date
  escola_id           String    @db.Uuid
  municipio_id        String    @db.Uuid
  ciclo_id            String    @db.Uuid
  ciclo_nome          String
  tipo_avaliacao_id   String    @db.Uuid
  total_alunos        Int
  total_professores   Int
  pontuacao_total_sum Float
  pontuacao_total_avg Float
  posicao_municipio   Int?
  posicao_geral       Int?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  escola         escola         @relation("ranking_escola_escola", fields: [escola_id], references: [id])
  municipio      municipio      @relation("ranking_escola_municipio", fields: [municipio_id], references: [id])
  ciclo          ciclo          @relation("ranking_escola_ciclo", fields: [ciclo_id], references: [id])
  tipo_avaliacao tipo_avaliacao @relation("ranking_escola_tipo", fields: [tipo_avaliacao_id], references: [id])
}

model import_batch {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id             String    @db.Uuid
  usuario_id               String    @db.Uuid
  status                   String    @default("pendente")
  total_rows               Int       @default(0)
  escolas_criadas          Int       @default(0)
  escolas_existentes       Int       @default(0)
  turmas_criadas           Int       @default(0)
  turmas_existentes        Int       @default(0)
  professores_criados      Int       @default(0)
  professores_existentes   Int       @default(0)
  coordenadores_criados    Int       @default(0)
  coordenadores_existentes Int       @default(0)
  diretores_criados        Int       @default(0)
  diretores_existentes     Int       @default(0)
  erros                    Int       @default(0)
  avisos                   Int       @default(0)
  undone_at                DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)

  municipio municipio          @relation(fields: [municipio_id], references: [id])
  usuario   usuario            @relation(fields: [usuario_id], references: [id])
  items     import_batch_item[]
  logs      import_batch_log[]
}

model import_batch_item {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id    String   @db.Uuid
  table_name  String
  record_id   String
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  batch import_batch @relation(fields: [batch_id], references: [id])
}

model import_batch_log {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id        String   @db.Uuid
  row_index       Int
  status          String
  message         String
  escola_nome     String?
  turma_nome      String?
  ciclo_input     String?
  professor_nome  String?
  professor_email String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  batch import_batch @relation(fields: [batch_id], references: [id])
}

// ─── Aluno Bulk Import Tracking ───────────────────────────

model import_aluno_batch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id      String    @db.Uuid
  usuario_id        String    @db.Uuid
  total_turmas      Int       @default(0)
  alunos_importados Int       @default(0)
  alunos_ignorados  Int       @default(0)
  erros             Int       @default(0)
  status            String    @default("pending")
  undone_at         DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  municipio municipio                @relation(fields: [municipio_id], references: [id])
  usuario   usuario                  @relation(fields: [usuario_id], references: [id])
  items     import_aluno_batch_item[]

  @@index([municipio_id])
  @@index([created_at(sort: Desc)])
}

model import_aluno_batch_item {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id   String   @db.Uuid
  aluno_id   String   @db.Uuid
  turma_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  batch import_aluno_batch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  aluno aluno              @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  turma turma              @relation(fields: [turma_id], references: [id])

  @@index([batch_id])
  @@index([aluno_id])
}

// ─── Painel da Assessora ────────────────────────────────

model reuniao {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id                String?                      @db.Uuid
  tipo                        reuniao_tipo
  inicio                      DateTime                     @db.Timestamptz(6)
  duracao_min                 Int
  titulo                      String?
  link                        String?
  observacao                  String?
  aconteceu                   Boolean                      @default(false)
  cancelada                   Boolean                      @default(false)
  serie_id                    String?                      @db.Uuid
  recorrencia_regra           reuniao_recorrencia_regra?
  recorrencia_ate             DateTime?                    @db.Date
  recorrencia_semana_do_mes   Int?
  criado_por                  String?                      @db.Uuid
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)

  municipio municipio?       @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  criador   usuario?         @relation("reuniao_criado_por", fields: [criado_por], references: [id])
  pessoas   reuniao_pessoa[]

  @@index([municipio_id, inicio], map: "idx_reuniao_municipio_inicio")
  @@index([inicio], map: "idx_reuniao_inicio")
  @@index([serie_id], map: "idx_reuniao_serie")
}

model reuniao_pessoa {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reuniao_id  String   @db.Uuid
  usuario_id  String?  @db.Uuid
  nome        String?
  email       String?
  perfil      String?
  presente    Boolean?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  reuniao reuniao  @relation(fields: [reuniao_id], references: [id], onDelete: Cascade)
  usuario usuario? @relation(fields: [usuario_id], references: [id])

  @@index([reuniao_id], map: "idx_reuniao_pessoa_reuniao")
  @@index([usuario_id], map: "idx_reuniao_pessoa_usuario")
}

model observacao_assessora {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id  String   @db.Uuid
  usuario_id    String?  @db.Uuid
  pessoa_nome   String?
  pessoa_perfil String?
  data          DateTime @db.Date
  conteudo      String
  criado_por    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  municipio municipio @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  usuario   usuario?  @relation("observacao_pessoa", fields: [usuario_id], references: [id])
  criador   usuario?  @relation("observacao_criado_por", fields: [criado_por], references: [id])

  @@index([municipio_id, data(sort: Desc)], map: "idx_observacao_municipio_data")
  @@index([usuario_id], map: "idx_observacao_usuario")
}

model tentativa_contato {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id  String   @db.Uuid
  usuario_id    String?  @db.Uuid
  pessoa_nome   String?
  pessoa_perfil String?
  data          DateTime @db.Date
  canal         String
  resultado     String
  observacao    String?
  criado_por    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  municipio municipio @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  usuario   usuario?  @relation("tentativa_pessoa", fields: [usuario_id], references: [id])
  criador   usuario?  @relation("tentativa_criado_por", fields: [criado_por], references: [id])

  @@index([municipio_id, data(sort: Desc)], map: "idx_tentativa_municipio_data")
  @@index([usuario_id], map: "idx_tentativa_usuario")
}

model feriado {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  data          DateTime  @db.Date
  municipio_id  String?   @db.Uuid
  uf_sigla      String?   @db.VarChar(2)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  municipio municipio? @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  uf        uf?        @relation(fields: [uf_sigla], references: [sigla])

  @@index([data], map: "idx_feriado_data")
  @@index([municipio_id], map: "idx_feriado_municipio")
  @@index([uf_sigla], map: "idx_feriado_uf")
}

model assessora_municipio {
  usuario_id   String   @db.Uuid
  municipio_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  created_by   String?  @db.Uuid

  usuario   usuario   @relation("assessora", fields: [usuario_id], references: [id], onDelete: Cascade)
  municipio municipio @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  creator   usuario?  @relation("assessora_creator", fields: [created_by], references: [id])

  @@id([usuario_id, municipio_id])
  @@index([usuario_id], map: "idx_assessora_municipio_usuario")
  @@index([municipio_id], map: "idx_assessora_municipio_municipio")
}

model usuario_impersonate_perm {
  usuario_id String   @id @db.Uuid
  granted_at DateTime @default(now()) @db.Timestamptz(6)
  granted_by String?  @db.Uuid

  usuario usuario  @relation("impersonate_target", fields: [usuario_id], references: [id], onDelete: Cascade)
  grantor usuario? @relation("impersonate_grantor", fields: [granted_by], references: [id], onDelete: SetNull)
}

model contato_principal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipio_id  String   @db.Uuid
  usuario_id    String?  @db.Uuid
  nome          String?
  email         String?
  telefone      String?
  perfil        String?
  cargo         String?
  ordem         Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  municipio municipio @relation(fields: [municipio_id], references: [id], onDelete: Cascade)
  usuario   usuario?  @relation(fields: [usuario_id], references: [id])

  @@index([municipio_id, ordem], map: "idx_contato_principal_municipio")
}

// ─── Formações presenciais (portal de eventos / PagBank) ─────────────────────
// Schema em supabase/migrations/*_create_formacao_eventos_schema.sql (lermais-auth).
// Prefixo `formacao_` porque `turma` já existe com outro significado (turma escolar).
// Índices parciais (checkout_id único quando não nulo) vivem só no banco — o Prisma
// não os modela.

model formacao_evento {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Permanente: liga o evento às vendas já registradas. Não renomear.
  slug          String   @unique
  cidade        String
  data          DateTime @db.Date
  local         String
  endereco      String
  como_chegar   String?
  /// null = sem limite; nunca esgota sozinho.
  vagas         Int?
  /// Piso do selo: a contagem de vendas só pode apertá-lo. abertas|ultimas|esgotado
  status_manual String?
  publicado     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  lotes  formacao_lote[]
  vendas formacao_venda[]

  @@index([data], map: "idx_formacao_evento_data")
  @@map("formacao_evento")
}

model formacao_lote {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id          String    @db.Uuid
  ordem              Int       @db.SmallInt
  nome               String
  preco_centavos     Int
  /// Vira expiration_date no checkout do PagBank.
  ate                DateTime  @db.Date
  /// >1 é o pacote institucional: 1 link, N vagas, valor total em preco_centavos.
  vagas_por_compra   Int       @default(1)
  visivel_no_site    Boolean   @default(true)
  /// CHEC_... do PagBank. null = link pag.ae legado criado à mão (não conta vaga).
  checkout_id        String?
  checkout_url       String?
  /// sandbox|producao — um CHEC_ de sandbox não existe em produção.
  checkout_ambiente  String?
  checkout_criado_em DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  evento formacao_evento  @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  vendas formacao_venda[]

  @@unique([evento_id, ordem])
  @@index([evento_id], map: "idx_formacao_lote_evento")
  @@map("formacao_lote")
}

model formacao_venda {
  /// CHAR_... do PagBank. Para origem 'manual', 'manual:<uuid>'.
  cobranca_id    String   @id
  pedido_id      String?
  /// Nulos em venda órfã (lookup do lote falhou): registrar é melhor que perder.
  lote_id        String?  @db.Uuid
  evento_id      String?  @db.Uuid
  /// Congelado do lote na hora da venda; editar o lote depois não muda o passado.
  vagas          Int      @default(1)
  /// Já sem os juros de parcelamento somados pelo PagBank ao amount.value.
  valor_centavos Int?
  /// pagbank|manual|pagbank_legado (link pag.ae importado pela API v2)|cortesia
  /// 'manual' é backfill agregado de planilha; 'cortesia' é uma pessoa lançada à mão
  /// no painel. Os insights tratam as duas de formas diferentes — ver a migration
  /// 20260826120000_formacao_venda_cortesia.sql.
  origem         String   @default("pagbank")
  /// sandbox|producao — toda contagem de vaga e receita filtra por 'producao'.
  ambiente       String   @default("producao")
  observacao     String?
  /// confirmada|cancelada
  status         String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Dados do pagamento — 24/08/2026, para o painel de insights.
  /// Quando o pagamento aconteceu. Em venda importada difere de created_at, que é o
  /// dia da importação: toda série temporal usa esta coluna.
  pago_em          DateTime? @db.Timestamptz(6)
  /// pix|credito|boleto|debito|saldo|outro
  metodo_pagamento String?
  /// Parcelas do cartão; null quando o método não parcela.
  parcelas         Int?      @db.SmallInt
  /// Taxa retida pelo PagBank. Líquido = valor_centavos - taxa_centavos.
  taxa_centavos    Int?

  // Dados do comprador — decisão de 24/08/2026, para a lista de inscritos do painel.
  // Minimização: sem CPF, embora o PagBank o mande. Ver a migration
  // 20260824040537_formacao_venda_dados_comprador.sql (finalidade e retenção).
  /// customer.name da notificação.
  comprador_nome      String?
  /// customer.email — validado pelo PagBank.
  comprador_email     String?
  /// customer.phone/phones concatenado. MOBILE não garante WhatsApp.
  comprador_celular   String?
  /// customer.tax_id, só dígitos. Guardado para uso futuro (NFS-e), sem finalidade
  /// hoje. NUNCA incluir em listagem — ler só sob finalidade declarada.
  comprador_cpf       String?
  /// Quando os dados pessoais foram anulados pelo expurgo.
  dados_expurgados_em DateTime? @db.Timestamptz(6)

  /// voucher|multiplicadora|parceria|equipe|outro — por que não pagou. Obrigatório em
  /// origem='cortesia', nulo nas demais (CHECK no banco). O detalhe livre vai em
  /// observacao.
  gratuidade_origem   String?

  lote   formacao_lote?   @relation(fields: [lote_id], references: [id], onDelete: SetNull)
  evento formacao_evento? @relation(fields: [evento_id], references: [id], onDelete: SetNull)

  @@index([evento_id, status, ambiente], map: "idx_formacao_venda_evento_status")
  @@index([lote_id], map: "idx_formacao_venda_lote")
  @@map("formacao_venda")
}

model formacao_webhook_evento {
  /// '<cobranca_id>:<status>' — o payload do PagBank não traz id de evento.
  evento_id   String   @id
  evento      String?
  recebido_em DateTime @default(now()) @db.Timestamptz(6)

  @@index([recebido_em], map: "idx_formacao_webhook_evento_recebido")
  @@map("formacao_webhook_evento")
}